# --- Core ---
PORT=4000
# Public URL where this server is reachable. Used for OAuth redirect URIs and for the
# signed video URLs that Instagram / Facebook / TikTok (PULL_FROM_URL) download from.
PUBLIC_BASE_URL=http://localhost:4000
# Where the database, uploads and renders live.
DATA_DIR=./data
# 32+ random chars. Encrypts stored OAuth tokens and signs public URLs. Auto-generated into DATA_DIR if empty.
RECAST_SECRET=
# Worker
WORKER_CONCURRENCY=2
POLL_INTERVAL_MINUTES=10
# Optional binaries
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# yt-dlp lets the YouTube / TikTok / URL-import sources download videos.
YTDLP_PATH=yt-dlp
# Allow creating "demo" connections that simulate a platform (on by default).
ALLOW_DEMO_CONNECTIONS=true
# Folder-based connectors may only read/write inside this directory (defaults to DATA_DIR/folders).
FOLDER_ROOT=

# --- Platform apps (fill in the ones you use; redirect URI = PUBLIC_BASE_URL/oauth/callback/<platform>) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
